# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Security Configuration
ENCRYPTION_KEY=your_32_character_secret_key_here

# JWT Authentication (required)
JWT_SECRET=your_64_character_jwt_secret_here

# Admin credentials — only required on FIRST startup to seed the database
# Can be removed from .env after first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here

# Logging Configuration
# Log levels: 0=DEBUG, 1=INFO, 2=SUCCESS, 3=WARN, 4=ERROR, 5=FATAL
# Development: Use 0 (DEBUG) to see all logs
# Production: Use 1 (INFO) to reduce noise
LOG_LEVEL=0

# Enable JSON formatted logs (useful for log aggregation tools like ELK, Loki)
# true = JSON format in app.json.log
# false = Human-readable format only
LOG_JSON=false
